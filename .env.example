# Copy to .env. Never paste these secrets into a demo, screenshot, or commit.
OPENAI_API_KEY=
PORT=3210
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
OBS_SCENE_SLIDES=Slides
OBS_SCENE_DEMO=Demo
OBS_MUSIC_INPUT=Beat
# Current OpenAI live transcription model; Decisions uses gpt-6-luna.
TRANSCRIPTION_MODEL=gpt-live-transcribe
# Local end-of-speech detector, tune with your microphone before presenting.
VAD_THRESHOLD=0.018
VAD_SILENCE_MS=400
