# Copy to .env. Never paste these secrets into a demo, screenshot, or commit.
OPENAI_API_KEY=
PORT=3210
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
OBS_SCENE_SLIDES=Slides
OBS_SCENE_DEMO=Demo
OBS_MUSIC_INPUT=Beat
# Live speech mode model; Full phrase selects gpt-transcribe in the UI.
# Decisions uses gpt-6-luna with recent speech and mapped stage state.
TRANSCRIPTION_MODEL=gpt-live-transcribe
# Local end-of-speech detector. Full phrase uses at least 700ms silence.
# Tune with your microphone before presenting; Finish phrase bypasses the pause.
VAD_THRESHOLD=0.018
VAD_SILENCE_MS=400
